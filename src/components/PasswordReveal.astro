---
// src/components/PasswordReveal.astro
//
// Wargame password reveal. Deliberately NOT FlagCapture: a wargame password (OverTheWire Bandit, etc.)
// is a WAYPOINT the reader pastes into SSH, not a trophy. So this uses the AMBER spoiler identity, no
// gold/loot styling, and NO signature decode (reserved for FlagCapture flags). Calm enough to appear on
// all 34 Bandit pages.
//
// Layout: PASSWORD label, the value blurred (spoiler-protected, plain text with no clickable framing),
// then ONE control on the right. It starts as eye + "Reveal"; on click the value unblurs and the SAME
// control swaps in place to copy + "Copy" (no layout shift, focus stays put). It is the ONLY interactive
// element in the row: the container and the value carry no click handler and no hover/press affordance.
//
// Accessibility: the value is always in the DOM (blur is purely visual), so screen readers get it. The
// control is a real <button>. Reveal/copy are announced via a VISUALLY HIDDEN aria-live region.
// prefers-reduced-motion skips the blur transition.

// TWO MODES, selected by content shape, because the interaction has to follow the secret's shape:
//   INLINE (password prop, no slot): a one-line wargame password. Blurs in place, copy button. UNCHANGED.
//   BLOCK  (slot content, no password prop): a multi-line secret (an RSA private key, a config dump) that
//          cannot be blurred as one inline run. Collapses instead, as a <details> the reader expands.
// Inline secrets blur, block secrets collapse. Both wear the same amber identity (--otw-amber /
// --otw-amber-ink / --pw-amber-rgb, set in tokens.css and consumed in components.css), which is the
// point of folding the old one-off spoiler class in here: one component, one amber, two shapes.
//
// Block mode ships with NO copy button on purpose: the keys it holds are truncated for publication, so a
// copy control would hand over a broken key. Better no affordance than a misleading one. Revisitable if a
// full, copyable block secret ever ships.

// The NOUN is a prop, the identity is not. `term` renames what the row calls its secret ("Password"
// on a wargame level, "Flag" on a PicoCTF challenge) and nothing else: the amber stays, the blur
// stays, the decode scramble stays absent. That is deliberate. Amber vs FlagCapture's gold no longer
// reads as "password vs flag", it reads as SIMPLE CHALLENGE vs MACHINE: a Bandit level and a PicoCTF
// challenge are both a few commands and a string, while an HTB or VulnHub box is a trophy with a
// ceremony. FlagCapture is reserved for those two platforms (2026-09-03, owner instruction).
interface Props {
  /** INLINE mode. The password value; present in the DOM for screen readers and copy, visually blurred until reveal. */
  password?: string;
  /** BLOCK mode. The summary label naming what is hidden, e.g. "Reveal private key". */
  label?: string;
  /**
   * INLINE mode. The noun for the secret, shown in the label (CSS uppercases it) and spoken in every
   * aria-label and announcement. Defaults to "Password" so all 34 Bandit pages are unchanged.
   */
  term?: string;
}

const { password, label = 'Reveal', term = 'Password' } = Astro.props;

// One capitalisation, derived once, so the visible label, the aria-labels and the live-region
// announcements cannot drift. CSS uppercases the visible label; the spoken forms stay sentence case.
const Term: string = term.trim() === '' ? 'Password' : term.trim();
const termLower: string = Term.toLowerCase();

// Mode is derived from the slot, never guessed: an ambiguous call is a build failure, not a silent choice.
const isBlock = Astro.slots.has('default');

if (isBlock && password !== undefined) {
  throw new Error(
    'PasswordReveal: pass EITHER a `password` prop (inline mode) OR slot content (block mode), not both.'
  );
}
if (!isBlock && password === undefined) {
  throw new Error(
    'PasswordReveal: nothing to reveal. Inline mode needs a `password` prop; block mode needs slot content.'
  );
}

// Already guaranteed non-null for the inline branch by the guard above; `?? ''` keeps the type-check clean.
const inlinePassword = password ?? '';
---

{isBlock && (
  <details class="toggle pwreveal-block">
    <summary>{label}</summary>
    <div class="toggle-body">
      <slot />
    </div>
  </details>
)}

{!isBlock && (
<div class="pwreveal" data-pwreveal data-password={inlinePassword} data-term={Term}>
  {/* The label and the value are ONE object, wrapped so they can share a baseline with each other
      while that whole object centres against the button. See .pw-secret in components.css. */}
  <span class="pw-secret">
    <span class="pw-label">{Term}</span>
    <code class="pw-value">{inlinePassword}</code>
  </span>

  <button type="button" class="pw-action" aria-label={`Reveal ${termLower}`}>
    <svg class="pw-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path class="pw-action-path" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" stroke-linecap="round" stroke-linejoin="round" />
      <circle class="pw-action-eye" cx="12" cy="12" r="3" />
    </svg>
    <span class="pw-action-text">Reveal</span>
  </button>

  <span class="pw-live sr-only" aria-live="polite"></span>
</div>
)}

<script>
  const COPY_PATH =
    'M16 1H4a2 2 0 0 0-2 2v14h2V3h12zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11z';

  function legacyCopy(text: string): void {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      document.execCommand('copy');
    } catch (_e) {
      /* no-op: clipboard simply unavailable */
    }
    ta.remove();
  }

  function copyText(text: string): void {
    const write = navigator.clipboard?.writeText(text);
    if (write && typeof write.catch === 'function') {
      write.catch(() => legacyCopy(text));
    } else {
      legacyCopy(text);
    }
  }

  function bind(root: HTMLElement): void {
    if (root.dataset.pwReady === 'true') return;
    root.dataset.pwReady = 'true';

    const btn = root.querySelector('.pw-action') as HTMLButtonElement | null;
    const ico = root.querySelector('.pw-action-ico') as SVGElement | null;
    const path = root.querySelector('.pw-action-path') as SVGPathElement | null;
    const eye = root.querySelector('.pw-action-eye') as SVGCircleElement | null;
    const text = root.querySelector('.pw-action-text') as HTMLElement | null;
    const live = root.querySelector('.pw-live') as HTMLElement | null;
    const password = root.dataset.password ?? '';
    // The noun travels in a data attribute rather than being read off .pw-label, whose text CSS
    // renders uppercase: announcing "FLAG REVEALED" would have a screen reader spell it out.
    const Term = root.dataset.term ?? 'Password';
    if (!btn) return;

    let revertId = 0;

    btn.addEventListener('click', () => {
      // First click: reveal. Value unblurs; the control becomes Copy in place.
      if (root.dataset.revealed !== 'true') {
        root.dataset.revealed = 'true';
        root.classList.add('is-revealed');
        if (eye) eye.remove(); // the copy glyph is a single filled path; drop the eye circle
        if (path) {
          path.setAttribute('d', COPY_PATH);
          path.removeAttribute('stroke-linecap');
          path.removeAttribute('stroke-linejoin');
        }
        if (ico) {
          ico.setAttribute('fill', 'currentColor');
          ico.removeAttribute('stroke');
        }
        if (text) text.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy to clipboard');
        if (live) live.textContent = `${Term} revealed`;
        return;
      }

      // Subsequent clicks: copy, with a brief confirmation that reverts.
      copyText(password);
      if (text) text.textContent = 'Copied';
      if (live) live.textContent = `${Term} copied`;
      window.clearTimeout(revertId);
      revertId = window.setTimeout(() => {
        if (text) text.textContent = 'Copy';
      }, 1400);
    });
  }

  function init(): void {
    (document.querySelectorAll('[data-pwreveal]') as NodeListOf<HTMLElement>).forEach(bind);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import {
  platformLogos, platformIcons, osLogos, osIcons, environmentIcons, categoryGlyph, platformSlug, difficultyLevel,
  type Platform, type OS, type Environment, type Difficulty,
} from './icons';
import DifficultyPips from './DifficultyPips.astro';
import { findGroup } from '../../lib/taxonomy.mjs';

interface Props {
  platform: Platform;
  // OPTIONAL since 2026-09-03, for the same reason difficulty is: some content has no honest value on
  // this axis. A PicoCTF web challenge is a URL and a browser; there is no target operating system in
  // evidence, and Linux|Windows has no "not applicable" member. Omit it and the OS chip does not
  // render. Never guess one: an invented OS is exactly what the omission exists to prevent, and the
  // injector already forwards the field only when frontmatter holds a non-empty string.
  os?: OS;
  environment: Environment;
  // OPTIONAL. A progressive wargame (OverTheWire Bandit) carries no difficulty rating, and the union
  // has no honest "none" member, so the axis is omitted rather than invented. Omit it and the
  // Difficulty chip does not render at all; supply it and nothing changes.
  difficulty?: Difficulty;
  // OPTIONAL (2026-09-07), PicoCTF in practice. The writeup's picoCTF category as the SLUG of its
  // middle directory (picoctf/<category>/<slug>.mdx), derived and forwarded by the injector exactly
  // as platform is, and never a frontmatter field (a frontmatter `category:` fails the build in the
  // injector). Validated below against src/lib/taxonomy.mjs, so an unknown directory fails here as
  // well. Omit it and no chip renders, which is every writeup outside picoctf/.
  category?: string;
}
const { platform, os, environment, difficulty, category } = Astro.props;

const platformClass: Record<Platform, string> = {
  HackTheBox: 'pf-htb', VulnHub: 'pf-vh', PicoCTF: 'pf-pico', OverTheWire: 'pf-otw',
};

// The four axes are string-literal unions, but `astro build` does not type-check .astro props and
// this repo has no `astro check` (it would pull in @astrojs/check + typescript). So the unions are
// only enforced in the editor, and a typo like difficulty="Hardd" would ship silently: data-level is
// dropped so no pips fill, the href becomes /platform/undefined, and screen readers announce
// "Difficulty undefined of 4". Fail the build instead of shipping that.
// Platform and OS each span TWO registries (polychrome <img> vs monochrome set:html), so every axis
// is checked against the union of its registries. This replaces the previous per-axis check plus a
// bespoke OS block: without it, platform="HackTheBox" would now throw, because HackTheBox has moved
// out of platformLogos and into platformIcons.
// `os` and `difficulty` join the list only when they are supplied, because both are optional (see
// Props): an absent value is a deliberate omission, while a value that IS present is still checked, so
// difficulty="Hardd" or os="Linnux" fails the build exactly as before. Never give either a fallback;
// inventing a rating or an operating system for content that has none is the precise thing the
// omission exists to prevent.
const axes: ReadonlyArray<readonly [string, string, readonly object[]]> = [
  ['platform', platform, [platformLogos, platformIcons]],
  ...(os === undefined ? [] : [['os', os, [osLogos, osIcons]] as const]),
  ['environment', environment, [environmentIcons]],
  ...(difficulty === undefined ? [] : [['difficulty', difficulty, [difficultyLevel]] as const]),
];
for (const [name, value, registries] of axes) {
  if (!registries.some((r) => Object.prototype.hasOwnProperty.call(r, value))) {
    const known = registries.flatMap((r) => Object.keys(r));
    throw new Error(`WriteupMeta: unknown ${name} "${value}". Expected one of: ${known.join(', ')}.`);
  }
}

// Category is validated against the taxonomy registry rather than an icon registry: it has ONE shared
// glyph (categoryGlyph) and its identity is the slug's hue on the ring (.tx-<slug>, components.css),
// so the registry that knows the six slugs is the one to check. Same posture as the loop above: an
// absent value is a deliberate omission, a present one must be a real category directory.
const categoryGroup = category === undefined ? undefined : findGroup('category', category);
if (category !== undefined && categoryGroup === undefined) {
  throw new Error(
    `WriteupMeta: unknown category "${category}". Expected one of the picoCTF category directory names in src/lib/taxonomy.mjs.`
  );
}
const categoryLabel: string | undefined = categoryGroup === undefined ? undefined : (categoryGroup.label as string);

const level = difficulty === undefined ? undefined : (difficultyLevel[difficulty] as 1 | 2 | 3 | 4);
// The difficulty chip carries .tx-<level> so the shared glyph can read the level's hue; the slug is the
// tier directory name, which is the lowercase enum value, resolved through the taxonomy registry so a
// renamed tier fails here instead of silently losing its hue (the same posture as category above).
const diffGroup = difficulty === undefined ? undefined : findGroup('difficulty', difficulty.toLowerCase());
if (difficulty !== undefined && diffGroup === undefined) {
  throw new Error(
    `WriteupMeta: difficulty "${difficulty}" has no tier in src/lib/taxonomy.mjs (its lowercase form must be a DIFFICULTY_TIERS slug).`
  );
}
const diffSlug = diffGroup === undefined ? undefined : (diffGroup.slug as string);
const osSlug = os === undefined ? undefined : os.toLowerCase();
const envSlug = environment.toLowerCase().replace(/\s+/g, '-');
// Per-value classes so CSS can color each chip (the slugs double as the class suffixes):
const osClass = `wm-os-${osSlug}`;    // wm-os-linux | wm-os-windows
const envClass = `wm-env-${envSlug}`; // wm-env-standalone | wm-env-active-directory
---
<!--
  Metadata chips are intentionally NON-INTERACTIVE until the /platform, /os and /environment filter
  routes ship (revisit after the mass writeup import). Those routes do not exist yet, so a clickable
  chip would point at a dead route; the chips render as static <span> below instead of <a>. The
  clickable <a> version is preserved as a comment right above the spans so it restores verbatim once
  the routes exist. See DECISIONS 2026-07-11 (metadata system entry).
-->
<!--
  `not-content` opts the chips out of Starlight's prose styling. Every .sl-markdown-content rule is
  guarded with :not(:where(.not-content *)), so this is the framework's own escape hatch: without it
  the prose-link rules (which reach (0,3,1) under :root[data-theme='light']) outrank the chip's own
  color and border, painting the labels teal with a tinted bottom edge in light mode. The guard skips
  descendants only, so .writeup-meta itself keeps its normal flow margins.
-->
<div class="writeup-meta not-content">
  <div class="wm-nav">
    {/* Metadata chips are intentionally non-interactive until the /platform, /os and /environment
        filter routes ship, to be revisited after the mass writeup import. The clickable <a> version
        is kept here (commented) so it restores verbatim: swap the static <span class="wm-chip">
        below back to these anchors once the routes exist, and drop the data-astro-prefetch="false"
        attrs then (they exist only to stop Starlight prefetching dead routes). The category anchor
        points at the platform landing's rail rather than a filter route, since the landing already
        filters by category client-side.
    <a class={`wm-chip ${platformClass[platform]}`} href={`/platform/${platformSlug[platform]}`} data-astro-prefetch="false">
      {platform === 'HackTheBox'
        ? <span class="wm-ico" set:html={platformIcons.HackTheBox} />
        : <img class="wm-ico wm-ico-logo" src={platformLogos[platform]} alt="" width="15" height="15" loading="lazy" decoding="async" />}{platform}
    </a>
    <a class={`wm-chip wm-cat tx-${category}`} href={`/picoctf/#${category}`} data-astro-prefetch="false">
      <span class="wm-ico wm-ico-cat" set:html={categoryGlyph} />{categoryLabel}
    </a>
    <a class={`wm-chip ${osClass}`} href={`/os/${osSlug}`} data-astro-prefetch="false">
      {os === 'Linux'
        ? <img class="wm-ico wm-ico-logo" src={osLogos.Linux} alt="" width="15" height="15" loading="lazy" decoding="async" />
        : <span class="wm-ico" set:html={osIcons.Windows} />}{os}
    </a>
    <a class={`wm-chip ${envClass}`} href={`/environment/${envSlug}`} data-astro-prefetch="false">
      <span class="wm-ico wm-ico-env" set:html={environmentIcons[environment]} />{environment}
    </a>
    */}
    <span class={`wm-chip ${platformClass[platform]}`}>
      {platform === 'HackTheBox'
        ? <span class="wm-ico" set:html={platformIcons.HackTheBox} />
        : <img class="wm-ico wm-ico-logo" src={platformLogos[platform]} alt="" width="15" height="15" loading="lazy" decoding="async" />}{platform}
    </span>
    {categoryLabel !== undefined && (
      <span class={`wm-chip wm-cat tx-${category}`}>
        <span class="wm-ico wm-ico-cat" set:html={categoryGlyph} />{categoryLabel}
      </span>
    )}
    {os !== undefined && (
      <span class={`wm-chip ${osClass}`}>
        {os === 'Linux'
          ? <img class="wm-ico wm-ico-logo" src={osLogos.Linux} alt="" width="15" height="15" loading="lazy" decoding="async" />
          : <span class="wm-ico" set:html={osIcons.Windows} />}{os}
      </span>
    )}
    <span class={`wm-chip ${envClass}`}>
      <span class="wm-ico wm-ico-env" set:html={environmentIcons[environment]} />{environment}
    </span>
  </div>
  {difficulty !== undefined && level !== undefined && (
    <span class="wm-diff">
      <span class={`wm-diff-chip tx-${diffSlug}`}>
        {difficulty}
        <DifficultyPips level={level} />
      </span>
    </span>
  )}
</div>

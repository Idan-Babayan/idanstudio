---
/**
 * PlatformIndex: data + layout for a platform landing page.
 *
 * Takes a `platform` prop, pulls that platform's writeups from the `docs`
 * collection (excluding the index page itself), resolves each one's GROUP on the
 * platform's own axis from the entry id path ({platform}/{group}/{slug}), sorts by
 * the axis's canonical order then title, and renders: a color-coded animated hero,
 * a filter rail whose pills carry the per-group counts, and a grid of <WriteupCard>.
 * Empty platforms show an "incoming" panel instead of a broken empty grid.
 *
 * THE AXIS IS PER PLATFORM (src/lib/taxonomy.mjs, 2026-09-07). What a writeup's middle
 * directory MEANS differs by platform: a difficulty tier on HackTheBox and VulnHub, a
 * picoCTF category on PicoCTF, a wargame on OverTheWire (mode="wargames", which never
 * consults the axis). This component used to assume difficulty everywhere and coerce
 * anything else to a "misc" tier that existed nowhere in the content, which rendered 21
 * PicoCTF challenges as misc. There is no fallback now: a middle directory outside its
 * platform's registry fails the build naming the allowed values, and a platform that
 * renders in writeups mode without an axis fails too, so a fifth platform is a decision.
 *
 * Effects (3D tilt + glare, scroll-reveal stagger, count-up, one-time decode)
 * are ported from src/pages/index.astro so these pages feel identical, not
 * reinvented. Everything is prefers-reduced-motion aware.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import WriteupCard from './WriteupCard.astro';
import { PLATFORM_AXIS, AXIS_GROUPS } from '../lib/taxonomy.mjs';

interface Props {
	platform: string;
	/**
	 * 'writeups' (default): cards are individual writeup pages, grouped on the platform's axis.
	 * 'wargames': cards are the platform's wargames (each sub-hub index page, e.g.
	 * overthewire/bandit), each linking to its hub. Levels live in the sidebar, never
	 * listed here, so the landing stays bounded as a wargame's level count grows.
	 */
	mode?: 'writeups' | 'wargames';
}
const { platform, mode = 'writeups' } = Astro.props;
const isWargames: boolean = mode === 'wargames';

type AxisKey = 'difficulty' | 'category';
interface Group {
	slug: string;
	label: string;
	level?: number;
}
/** The card's view of a group (mirrors WriteupCard's CardGroup; the level is narrowed there). */
interface CardGroup {
	key: AxisKey;
	slug: string;
	label: string;
	level?: 1 | 2 | 3 | 4;
}

// The axis is dereferenced ONLY in writeups mode: OverTheWire renders in wargames mode and has no
// entry in the table on purpose.
const axis: AxisKey | null = isWargames
	? null
	: ((PLATFORM_AXIS as Record<string, AxisKey | undefined>)[platform] ?? null);
if (!isWargames && axis === null) {
	throw new Error(
		`PlatformIndex: platform "${platform}" renders in writeups mode but declares no axis in src/lib/taxonomy.mjs. ` +
			`Add it to PLATFORM_AXIS (difficulty or category) or render it with mode="wargames".`
	);
}
const groups: Group[] = axis === null ? [] : (AXIS_GROUPS as Record<AxisKey, Group[]>)[axis];

interface PlatformMeta {
	name: string;
	tagline: string; // one line, no em dashes
	icon: string;
}
const PLATFORM_META: Record<string, PlatformMeta> = {
	hackthebox: { name: 'HackTheBox', tagline: 'Retired machines, owned and documented.', icon: '/icons/htb.svg' },
	vulnhub: { name: 'VulnHub', tagline: 'Vulnerable VMs, pulled apart in my home lab.', icon: '/icons/vulnhub.svg' },
	picoctf: { name: 'PicoCTF', tagline: 'Where I built my CTF fundamentals.', icon: '/icons/picoctf.svg' },
	overthewire: { name: 'OverTheWire', tagline: 'Wargames that taught me Linux the hard way.', icon: '/icons/overthewire.svg' },
};
const meta: PlatformMeta = PLATFORM_META[platform] ?? {
	name: platform,
	tagline: '',
	icon: `/icons/${platform}.svg`,
};

type Entry = CollectionEntry<'docs'>;

interface CardModel {
	href: string;
	title: string;
	description?: string;
	group: CardGroup;
	os?: string;
	environment?: string;
}

/**
 * The entry's group on the platform's axis, from the DIRECTORY: {platform}/{group}/{slug}.
 * The directory is authoritative (as it is for the sidebar and for the injected badge row), so a
 * card, the rail count and the filter can never disagree. Anything else fails the build.
 */
function groupOf(entry: Entry): CardGroup {
	const parts = entry.id.split('/');
	if (parts.length < 3) {
		throw new Error(
			`PlatformIndex: "${entry.id}" sits directly under ${platform}/ with no ${axis} directory. ` +
				`Expected ${platform}/<${axis}>/<slug>, where <${axis}> is one of: ${groups.map((g) => g.slug).join(', ')}.`
		);
	}
	const slug = parts[1];
	const found = groups.find((g) => g.slug === slug);
	if (!found) {
		throw new Error(
			`PlatformIndex: "${entry.id}" sits under unknown ${axis} directory "${slug}". ` +
				`Expected one of: ${groups.map((g) => g.slug).join(', ')} (src/lib/taxonomy.mjs). There is no fallback tier.`
		);
	}
	return { key: axis as AxisKey, slug: found.slug, label: found.label, level: found.level as 1 | 2 | 3 | 4 | undefined };
}
const rankOf = (slug: string): number => groups.findIndex((g) => g.slug === slug);

/**
 * Card copy. A PicoCTF description opens "PicoCTF <Title>: ..." because that string is the SEO and
 * Open Graph description, and it stays exactly as authored; the card, which already shows the title,
 * does not repeat it. The prefix is matched as the platform name followed by up to eighty non-colon
 * characters and a colon, NOT as the title itself, because a title can differ from what the
 * description repeats ("EVEN RSA CAN BE BROKEN???" does not match its own description prefix).
 * HackTheBox descriptions never match and pass through; wargame cards never call this.
 */
function cardDescription(description: string | undefined): string | undefined {
	if (!description) return description;
	const escaped = meta.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	const prefix = new RegExp(`^${escaped}\\s+[^:]{1,80}:\\s*`, 'i');
	const stripped = description.replace(prefix, '');
	if (stripped === description) return description;
	return stripped.charAt(0).toUpperCase() + stripped.slice(1);
}

const all = await getCollection('docs');

// Everything under this platform. The platform index page's id is exactly `{platform}`
// (no trailing segment), so `startsWith('{platform}/')` excludes it cleanly.
const entries: Entry[] = all.filter((e) => e.id.startsWith(`${platform}/`));

// WARGAME cards (mode="wargames"): a wargame's hub is the index page one segment under the
// platform, e.g. `overthewire/bandit`. Levels (`overthewire/bandit/0-1`) carry an extra
// segment and are deliberately excluded, they are reached via the sidebar, never listed here.
interface WargameModel {
	href: string;
	title: string;
	description?: string;
}
const wargames: WargameModel[] = isWargames
	? entries
		.filter((e) => e.id.split('/').length === 2)
		.map((e): WargameModel => ({
			href: `/${e.id.toLowerCase()}/`,
			title: e.data.title,
			description: e.data.description,
		}))
		.sort((a, b) => a.title.localeCompare(b.title))
	: [];

// WRITEUP cards (default mode): individual writeup pages, grouped on the axis. Empty in
// wargames mode so the per-level pages never render as a card wall.
const cards: CardModel[] = isWargames
	? []
	: entries
		.map((e): CardModel => ({
			// Starlight lowercases doc URLs even though entry ids preserve folder casing.
			href: `/${e.id.toLowerCase()}/`,
			title: e.data.title,
			description: cardDescription(e.data.description),
			group: groupOf(e),
			os: e.data.os,
			environment: e.data.environment,
		}))
		.sort((a, b) => {
			const d = rankOf(a.group.slug) - rankOf(b.group.slug);
			return d !== 0 ? d : a.title.localeCompare(b.title);
		});

const total: number = isWargames ? wargames.length : cards.length;

// Per-group counts in canonical order, for the filter rail (writeups mode only; cards is empty in
// wargames mode, so `present` stays empty and the rail self-hides).
const counts = new Map<string, number>();
for (const c of cards) counts.set(c.group.slug, (counts.get(c.group.slug) ?? 0) + 1);
const present: Group[] = groups.filter((g) => (counts.get(g.slug) ?? 0) > 0);
// A single group makes the rail pointless; only show it with 2+ (never in wargames mode).
const showFilter: boolean = !isWargames && present.length > 1;
const isEmpty: boolean = total === 0;

// The facts rule: a card fact earns a slot only if it VARIES within the platform. Environment is
// constant across every PicoCTF card (Standalone), so it says nothing there and is hidden; it
// varies on HackTheBox (Standalone against Active Directory) and shows. Computed, not declared.
const showEnv: boolean = new Set(cards.map((c) => c.environment).filter(Boolean)).size > 1;

const countLabel = (n: number): string => (n === 1 ? 'writeup' : 'writeups');
---

{/* not-content: Starlight's opt-out for component UI inside docs. Its prose styles
    (and our guarded prose.css rules) skip this subtree, so the hero, filter
    rail, and cards style deterministically without specificity arms races. */}
<div class={`pi-index not-content pf-${platform}`}>
	<!-- HERO -->
	<header class="pi-hero">
		<span class="pi-glow" aria-hidden="true"></span>
		<div class="pi-hero-inner">
			<div class="pi-hero-text">
				<div class="pi-eyebrow reveal">// {meta.name.toUpperCase()}</div>
				<h1 class="pi-name decode reveal" data-word={meta.name}>{meta.name}</h1>
				{meta.tagline && <p class="pi-tagline reveal">{meta.tagline}</p>}

				{!isEmpty && (
					<div class="pi-stats reveal">
						{/* The resting HTML holds the FINAL value, so crawlers and
						    reduced-motion readers see the real number (a no-script visitor sees none of the hero,
						    which stays at opacity 0 until the reveal script runs, the homepage rule); countUp animates from 0 only when it
						    runs (the homepage rule). */}
						<div class="pi-stat">
							<div class="pi-num" data-count={total}>{total}</div>
							<div class="pi-lbl">{isWargames ? (total === 1 ? 'Wargame' : 'Wargames') : total === 1 ? 'Writeup' : 'Writeups'}</div>
						</div>
						{/* A category-axis platform is a catalog, so its hero carries a second number: how
						    many categories the writeups span. A difficulty-axis platform keeps one; the two
						    heroes differ in structure, not in a coat of paint. */}
						{axis === 'category' && present.length > 0 && (
							<div class="pi-stat">
								<div class="pi-num" data-count={present.length}>{present.length}</div>
								<div class="pi-lbl">{present.length === 1 ? 'Category' : 'Categories'}</div>
							</div>
						)}
					</div>
				)}
			</div>

			<div class="pi-logo-wrap reveal">
				<img class="pi-logo" src={meta.icon} alt={`${meta.name} logo`} data-zoom-off loading="eager" decoding="async" />
			</div>
		</div>
	</header>

	{isEmpty ? (
		<div class="pi-empty reveal">
			<p class="pi-empty-title">Writeups landing soon</p>
			<p class="pi-empty-text">
				{meta.name} writeups are in the lab and on the way. Check back shortly, the recon is already underway.
			</p>
		</div>
	) : (
		<>
			{/* The rail is the ONE place the page enumerates its groups: each pill carries its count, so
			    there is no separate breakdown line in the hero. ALL is neutral (the base --pill, no count:
			    the hero owns the total); each group pill carries .tx-<slug>, which sets --tx, which the
			    scoped style reads as --pill. Group pills are independent toggle buttons (aria-pressed; any
			    number pressed, the filter is the union); ALL is the no-filter state and clears them; the
			    visually hidden status announces the result. The rail carries the axis as data-filter-key. */}
			{showFilter && axis !== null && (
				<div class="pi-filters reveal" role="group" aria-label={`Filter writeups by ${axis}`} data-filter-key={axis}>
					<button type="button" class="pi-pill is-active" data-filter="all" aria-pressed="true">All</button>
					{present.map((g) => (
						<button type="button" class={`pi-pill tx-${g.slug}`} data-filter={g.slug} data-label={g.label} aria-pressed="false">
							{g.label}
							<span class="pi-pill-n" aria-hidden="true">{counts.get(g.slug)}</span>
							<span class="sr-only">{`, ${counts.get(g.slug)} ${countLabel(counts.get(g.slug) ?? 0)}`}</span>
						</button>
					))}
					<span class="pi-filter-status sr-only" aria-live="polite"></span>
				</div>
			)}

			<div class="pi-grid">
				{isWargames
					? wargames.map((wg) => (
						<a
							href={wg.href}
							class="pi-wg-card reveal"
							data-tilt
							aria-label={`Enter the ${wg.title} wargame`}
						>
							<span class="pi-wg-bar" aria-hidden="true"></span>
							<span class="pi-wg-glare" aria-hidden="true"></span>
							<div class="pi-wg-eyebrow">// WARGAME</div>
							<h3 class="pi-wg-name">{wg.title}</h3>
							{wg.description && <p class="pi-wg-desc">{wg.description}</p>}
							<span class="pi-wg-go">Enter wargame <span class="pi-wg-arrow" aria-hidden="true">-&gt;</span></span>
						</a>
					))
					: cards.map((c) => (
						<WriteupCard
							href={c.href}
							title={c.title}
							description={c.description}
							platform={platform}
							group={c.group}
							os={c.os}
							environment={c.environment}
							showEnvironment={showEnv}
						/>
					))}
			</div>
		</>
	)}
</div>

<style>
	.pi-index {
		position: relative;
		/* Platform color leads; universal cyan secondary is the duotone partner (theme-aware). */
		--accent: var(--pf-accent, var(--sl-color-accent));
		--accent-2: var(--pf-accent-2, var(--tp-cyan));
		/* The accent's TEXT variant, for body-size type that has to clear 4.5:1 where the accent only
		   clears the 3:1 large-text bar. On dark --pf-ink IS --pf-accent, so this changes nothing there.
		   The fallback is the same graceful degradation the two lines above already apply to
		   --pf-accent: it fires only for a platform index rendered with no .pf-* token, which is zero
		   pages today but is exactly what a fifth platform would be on the day it is added. Without it
		   that page's eyebrow would resolve to no colour at all rather than to the accent. */
		--accent-ink: var(--pf-ink, var(--accent));
		/* Everything on the landing rings in the platform by default (the wargame card, any control
		   without a group); the rail pills and the writeup cards override to their own hue below and in
		   pages.css. Before 2026-09-07 the wargame card fell through to the site default ring. */
		--focus-ring: var(--accent);
	}

	/* ── HERO ── */
	.pi-hero {
		position: relative;
		padding: 0.5rem 0 2.25rem;
		margin-bottom: 1.5rem;
	}
	.pi-glow {
		position: absolute;
		inset: -40% -10% auto -12%;
		height: 360px;
		z-index: 0;
		pointer-events: none;
		/* Duotone wash: the platform color leads on the left, a softer cyan pool on the right,
		   so the atmosphere is never one flat hue. */
		background:
			radial-gradient(52% 100% at 20% 0%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
			radial-gradient(46% 90% at 80% 8%, color-mix(in oklab, var(--accent-2) 13%, transparent), transparent 72%);
	}
	/* LIGHT: the pools sit behind the MARK, not the type. On paper the wash is the platform's own
	   accent laid over the surface its own text reads on, so a pool at 20% x put every hero consumer
	   under a 32% tint of its own colour: the eyebrow measured 3.36 on HackTheBox and 3.05 on VulnHub
	   against a 4.5 bar. Moving the pool right clears the type at full wash strength (peak alpha 0.322
	   to 0.316), rather than paying for contrast by dimming the atmosphere. Dark is untouched: it has
	   no failure to fix (its floor is 5.68) and its own rule above still pools left.

	   TWO ALTERNATIVES THAT MEASURE WELL AND ARE TRAPS. Do not reach for either.
	   1. Shifting the glow UP instead of sideways. The inset is a percentage of the HERO's height and
	      heroes differ (measured 279px on HackTheBox against 183px on VulnHub), so `top: -95%` reached
	      bare paper on two platforms and only 3.65 on VulnHub. Horizontal relocation is uniform because
	      the gradient position resolves against the GLOW box, a fixed 360px on every page.
	   2. Pulling the gradient's own centre up (`at 20% -55%`). It reads as a geometry change and is an
	      alpha cut: peak visible alpha collapses from 0.322 to 0.076, so it is lever 2 wearing a
	      costume, and it costs the wash for the same result this rule gets for free.
	   Pooling DOWN was also measured and rejected outright: it breaks .pi-num, 4.11 to 3.23. */
	html[data-theme='light'] .pi-glow {
		background:
			radial-gradient(52% 100% at 86% 0%, color-mix(in oklab, var(--accent) 32%, transparent), transparent 72%),
			radial-gradient(46% 90% at 95% 8%, color-mix(in oklab, var(--accent-2) 18%, transparent), transparent 74%);
	}
	.pi-hero-inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.pi-hero-text {
		flex: 1;
		min-width: 260px;
	}

	.pi-eyebrow {
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		/* 12.8px/400 is body text at the 4.5:1 bar, so it reads the ink, not the accent. The 38px
		   rule in ::before below stays on the accent: it is a graphic, not text. */
		color: var(--accent-ink);
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.pi-eyebrow::before {
		content: '';
		width: 38px;
		height: 1px;
		background: var(--accent);
		display: inline-block;
	}

	/* h1 inside markdown content; override the default heading color with the accent. */
	.pi-name {
		font-family: var(--tp-display);
		font-weight: 800;
		font-size: clamp(2.2rem, 5.5vw, 3.6rem);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--accent);
		margin: 0 0 0.9rem;
	}
	.pi-tagline {
		color: color-mix(in oklab, var(--sl-color-text) 72%, transparent);
		font-size: clamp(0.95rem, 1.4vw, 1.1rem);
		line-height: 1.6;
		max-width: 46ch;
		margin: 0;
	}

	/* ── STAT STRIP ── */
	.pi-stats {
		display: flex;
		align-items: baseline;
		gap: 1.5rem;
		margin-top: 1.7rem;
		flex-wrap: wrap;
	}
	.pi-stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.pi-num {
		font-family: var(--sl-font-mono);
		font-weight: 700;
		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1;
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}
	/* Secondary stat label uses the cyan secondary (the big number stays the platform color). */
	.pi-lbl {
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent-2);
	}

	/* ── LOGO ── */
	.pi-logo-wrap {
		position: relative;
		flex-shrink: 0;
	}
	.pi-logo-wrap::before {
		content: '';
		position: absolute;
		inset: -22%;
		border-radius: 50%;
		z-index: 0;
		background: radial-gradient(circle, color-mix(in oklab, var(--accent) 28%, transparent), transparent 64%);
	}
	.pi-logo {
		position: relative;
		z-index: 1;
		width: 108px;
		height: 108px;
		object-fit: contain;
		filter: drop-shadow(0 0 18px color-mix(in oklab, var(--accent) 45%, transparent));
	}

	/* ── FILTER RAIL ──
	   Pills wear the VALUE register (Title Case mono 600, the type every chip on the site wears) and
	   are tinted in the group hue, as the cards are since 2026-09-07: label, border and a 12% fill in
	   --pill. A group
	   pill carries the global .tx-<slug> class (components.css), which sets --tx from the difficulty
	   arc or the category ring; the rule below reads it into --pill. ALL keeps the base neutral (Starlight's gray-2, dark
	   9.34 and light 7.88 on its own 12% fill) so "no filter" is a control, not a colour, on every
	   platform. Measured on the fill over the page (model B): every light label 5.1 or better at
	   rest and, because light keeps the 12% fill when pressed, the same when pressed; dark 5.4 or
	   better pressed (the arc's Hard, 5.43). The 45% rest border is a decorative boundary (about 2.1:1 on paper): the fill
	   and the label identify the control, and the pressed state adds weight 700 and a 2px ring plus a soft glow
	   in the pill's OWN hue. */
	.pi-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.6rem;
	}
	.pi-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.4;
		/* 0.4rem block padding lifts the target to about 30px (WCAG 2.2 asks 24). */
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		cursor: pointer;
		--pill: var(--sl-color-gray-2);
		color: var(--pill);
		border: 1px solid color-mix(in oklab, var(--pill) 45%, transparent);
		background: color-mix(in oklab, var(--pill) 12%, transparent);
		/* The pill rings in its OWN hue (owner decision 2026-09-07): the group hue on a group pill, the
		   neutral on ALL, the colour its label, border, fill and pressed ring already wear, and the rule
		   the cards follow. Against the page the arc reads 7.38 or better dark and 6.15 or better light,
		   the neutral 11.31 and 9.65. */
		--focus-ring: var(--pill);
		transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}
	.pi-pill[class*='tx-'] {
		--pill: var(--tx);
	}
	.pi-pill-n {
		font-weight: 400;
		font-variant-numeric: tabular-nums;
	}
	.pi-pill:hover {
		transform: translateY(-1px);
		border-color: color-mix(in oklab, var(--pill) 70%, transparent);
	}
	/* Pressed: weight 700 and the pill's OWN hue as the selected indicator, a 2px ring flush against the
	   border plus a soft glow beneath, both in --pill (owner decision 2026-09-07, replacing the cyan
	   secondary the 2026-06-14 duotone put there: a selected Easy is more Easy, not more cyan, and ALL
	   rings in its neutral). The border keeps its resting 45% so the ring reads as a ring rather than
	   thickening the border into a 3px band. Dark also lifts the fill to 22%. The ring is the label's
	   own colour, so against the pressed fill it carries the label's ratio (dark 5.4 to 7.4 on the 22%
	   fill, light 5.1 to 7.8, measured with the transition disabled), and against the page it reads
	   7.4 to 11.6 dark and 6.1 to 9.7 light (the dark floor is the arc's magenta, the Hard tier,
	   measured on a fixture the same day). */
	.pi-pill.is-active {
		font-weight: 700;
		background: color-mix(in oklab, var(--pill) 22%, transparent);
		box-shadow: 0 0 0 2px var(--pill), 0 6px 18px -8px var(--pill);
	}
	/* LIGHT: the pressed fill stays at the resting 12%. On paper the label sits on a fill mixed from
	   its OWN hue, the one backdrop no wash change can reach, and the ring values were solved on that
	   12% fill; the 2026-07-31 pass already found the tint the weakest of the three pressed cues, so
	   light spends weight and the own-hue ring instead of a tint step. */
	html[data-theme='light'] .pi-pill.is-active {
		background: color-mix(in oklab, var(--pill) 12%, transparent);
	}
	/* Narrow screens: the counts leave the pills so the six-category PicoCTF rail stays two rows. The
	   visually hidden ", N writeups" inside each pill still carries the number. */
	@media (max-width: 480px) {
		.pi-pill-n {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pi-pill,
		.pi-pill:hover {
			transform: none;
			transition: none;
		}
	}

	/* ── GRID ── */
	.pi-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.1rem;
	}

	/* ── EMPTY STATE ── */
	.pi-empty {
		position: relative;
		overflow: hidden;
		border-radius: 16px;
		padding: 2.6rem 2rem;
		text-align: center;
		border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
		border-left: 3px solid var(--accent);
		background: color-mix(in oklab, var(--accent) 8%, transparent);
	}
	html[data-theme='light'] .pi-empty {
		background: color-mix(in oklab, var(--accent) 12%, #f4f1e8);
		box-shadow: 0 8px 24px -16px rgba(60, 50, 30, 0.4);
	}
	.pi-empty-title {
		font-family: var(--tp-display);
		font-weight: 700;
		font-size: 1.45rem;
		color: var(--accent);
		margin: 0 0 0.5rem;
	}
	.pi-empty-text {
		color: color-mix(in oklab, var(--sl-color-text) 65%, transparent);
		font-size: 0.92rem;
		line-height: 1.6;
		max-width: 46ch;
		margin: 0 auto;
	}

	@media (max-width: 640px) {
		.pi-hero-inner {
			flex-direction: column-reverse;
			align-items: flex-start;
		}
		.pi-stats {
			gap: 1.1rem;
		}
	}

	/* ── WARGAME CARD (mode="wargames") ──────────────────────────────────────────────
	   A bounded card linking to a wargame hub. Mirrors the WriteupCard look (accent bar,
	   cursor glare, 3D tilt) so the landing stays cohesive; tilt, glare, and reveal are driven
	   by the shared script below via data-tilt + .reveal, the same hooks WriteupCard uses. */
	.pi-wg-card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: #0d1113;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		padding: 1.6rem 1.5rem;
		text-decoration: none;
		color: var(--sl-color-text);
		transform-style: preserve-3d;
		transition: transform 0.12s ease, border-color 0.3s ease;
		overflow: hidden;
		will-change: transform;
	}
	html[data-theme='light'] .pi-wg-card {
		background: #f7f5ee;
		border-color: rgba(0, 0, 0, 0.12);
		box-shadow: 0 8px 24px -16px rgba(60, 50, 30, 0.45);
	}
	.pi-wg-card:hover {
		border-color: var(--accent);
	}
	/* Same fix as WriteupCard: the light base rule outranks the hover rule, so the amber hover border
	   never showed on paper before 2026-09-07. */
	html[data-theme='light'] .pi-wg-card:hover {
		border-color: var(--accent);
	}
	.pi-wg-bar {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--accent);
	}
	.pi-wg-glare {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), color-mix(in oklab, var(--accent) 22%, transparent), transparent 45%);
	}
	.pi-wg-card:hover .pi-wg-glare {
		opacity: 1;
	}
	.pi-wg-eyebrow {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accent-2);
	}
	.pi-wg-name {
		font-family: var(--tp-display);
		font-weight: 700;
		font-size: 1.4rem;
		line-height: 1.15;
		color: var(--sl-color-text);
		margin: 0.6rem 0 0;
		transform: translateZ(40px);
	}
	.pi-wg-desc {
		color: color-mix(in oklab, var(--sl-color-text) 62%, transparent);
		font-size: 0.86rem;
		line-height: 1.55;
		margin: 0.85rem 0 0;
		transform: translateZ(20px);
	}
	.pi-wg-go {
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--accent-2);
		margin-top: 1.1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transform: translateZ(30px);
	}
	.pi-wg-arrow {
		transition: transform 0.2s ease;
	}
	.pi-wg-card:hover .pi-wg-arrow {
		transform: translateX(4px);
	}
	@media (prefers-reduced-motion: reduce) {
		.pi-wg-card {
			transition: none;
		}
		.pi-wg-card:hover {
			transform: none !important;
		}
		.pi-wg-arrow,
		.pi-wg-card:hover .pi-wg-arrow {
			transition: none;
		}
	}
</style>

<script>
	/* Effects ported from src/pages/index.astro so the page feels identical.
	   Scoped to .pi-index so nothing leaks to the rest of the Starlight doc. */
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* One-time text decode (the page's single decode moment). */
	function decode(el: HTMLElement) {
		const target = el.dataset.word ?? '';
		const chars = '!<>-_\\/[]{}=+*^?#01';
		let frame = 0;
		const dur = 38;
		const id = setInterval(() => {
			el.textContent = target
				.split('')
				.map((c, i) => ((frame / dur) * target.length > i ? c : chars[Math.floor(Math.random() * chars.length)]))
				.join('');
			if (frame++ > dur) {
				clearInterval(id);
				el.textContent = target;
			}
		}, 45);
	}

	/* Count up (cubic ease-out, 1400ms): ported from the homepage without its synchronous reset to 0
	   (the resting HTML holds the final value here; data-text / data-suffix stay for parity and have
	   no producer on this page), including its reduced-motion
	   gate: the resting HTML already holds the final value, so under reduced motion the number is
	   simply left (re-set, in case the reveal ran) at its end value and never animates. */
	function countUp(el: HTMLElement) {
		const text = el.dataset.text;
		if (text) {
			el.textContent = text;
			return;
		}
		const end = +(el.dataset.count ?? '0');
		const suf = el.dataset.suffix ?? '';
		if (reduce) {
			el.textContent = String(end) + suf;
			return;
		}
		const dur = 1400;
		let s: number | null = null;
		const step = (t: number) => {
			if (s === null) s = t;
			const p = Math.min((t - s) / dur, 1);
			const e = 1 - Math.pow(1 - p, 3);
			el.textContent = Math.floor(e * end) + (p === 1 ? suf : '');
			if (p < 1) requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}

	/* Scroll-reveal stagger via IntersectionObserver: same threshold + delay as the homepage.
	   Hero reveals are handled on load below, so they are observed but skipped here. */
	const io = new IntersectionObserver(
		(ents) => {
			ents.forEach((e) => {
				if (e.isIntersecting) {
					e.target.classList.add('in');
					(e.target.querySelectorAll('[data-count],[data-text]') as NodeListOf<HTMLElement>).forEach(countUp);
					io.unobserve(e.target);
				}
			});
		},
		{ threshold: 0.2 }
	);
	(document.querySelectorAll('.pi-index .reveal') as NodeListOf<HTMLElement>).forEach((el, i) => {
		el.style.transitionDelay = (i % 4) * 90 + 'ms';
		if (!el.closest('.pi-hero')) io.observe(el);
	});

	window.addEventListener('load', () => {
		document.querySelectorAll('.pi-hero .reveal').forEach((el, i) =>
			setTimeout(() => {
				el.classList.add('in');
				(el.querySelectorAll('[data-count],[data-text]') as NodeListOf<HTMLElement>).forEach(countUp);
			}, 120 * i)
		);
		const d = document.querySelector('.pi-name.decode') as HTMLElement | null;
		if (d && !reduce) setTimeout(() => decode(d), 600);
		else if (d) d.textContent = d.dataset.word ?? '';
	});

	/* 3D tilt + cursor glare: verbatim from the homepage (perspective 800, +/-10deg). */
	if (!reduce)
		(document.querySelectorAll('.pi-index [data-tilt]') as NodeListOf<HTMLElement>).forEach((card) => {
			card.addEventListener('mousemove', (e) => {
				const r = card.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width,
					py = (e.clientY - r.top) / r.height;
				card.style.transform = `perspective(800px) rotateY(${(px - 0.5) * 10}deg) rotateX(${(0.5 - py) * 10}deg) translateY(-4px)`;
				card.style.setProperty('--mx', px * 100 + '%');
				card.style.setProperty('--my', py * 100 + '%');
			});
			card.addEventListener('mouseleave', () => {
				card.style.transform = '';
			});
		});

	/* Filter rail: client-side show/hide, MULTI-SELECT (owner decision 2026-09-07). The rail carries
	   data-filter-key (the card data-* dimension: difficulty on HackTheBox, category on PicoCTF) and each
	   group pill data-filter (the value) and data-label (its word), so one script serves both axes. Group
	   pills are independent toggle buttons: any number may be pressed and a card shows when it matches ANY
	   pressed value (the union, so Easy plus Medium lists both tiers); pressing a pressed pill releases it.
	   ALL is the no-filter STATE, not a value: it is pressed exactly when no group pill is, and pressing it
	   releases every group pill. aria-pressed follows .is-active on every pill and the visually hidden
	   live region announces the result with the pressed labels. Cards expose data-difficulty or
	   data-category, plus data-platform / data-tags. */
	const rail = document.querySelector('.pi-filters') as HTMLElement | null;
	const filterKey: string = rail?.dataset.filterKey ?? '';
	const pills = Array.from(document.querySelectorAll('.pi-pill')) as HTMLElement[];
	const allPill = (pills.find((p) => p.dataset.filter === 'all') ?? null) as HTMLElement | null;
	const groupPills: HTMLElement[] = pills.filter((p) => p.dataset.filter !== 'all');
	const cards = Array.from(document.querySelectorAll('.pi-index .wc-card')) as HTMLElement[];
	const status = document.querySelector('.pi-filter-status') as HTMLElement | null;
	function setPressed(p: HTMLElement, on: boolean) {
		p.classList.toggle('is-active', on);
		p.setAttribute('aria-pressed', on ? 'true' : 'false');
	}
	function applyFilter() {
		const pressed = groupPills.filter((p) => p.classList.contains('is-active'));
		const wanted = new Set(pressed.map((p) => p.dataset.filter ?? ''));
		let shown = 0;
		cards.forEach((c) => {
			const values = (c.dataset[filterKey] ?? '').split(',').map((s) => s.trim());
			const show = wanted.size === 0 || values.some((v) => wanted.has(v));
			c.classList.toggle('wc-hidden', !show);
			// Guarantee a filtered-in card is visible even if it never scrolled into view.
			if (show) {
				c.classList.add('in');
				shown++;
			}
		});
		if (allPill) setPressed(allPill, wanted.size === 0);
		if (status) {
			const names = pressed.map((p) => p.dataset.label ?? p.dataset.filter ?? '').join(', ');
			status.textContent =
				wanted.size === 0 ? `Showing all ${cards.length} writeups` : `Showing ${shown} of ${cards.length} writeups: ${names}`;
		}
	}
	// No fallback dimension: a rail with no data-filter-key filters nothing, visibly, rather than silently
	// filtering by difficulty on a category platform.
	if (filterKey) {
		groupPills.forEach((p) =>
			p.addEventListener('click', () => {
				setPressed(p, !p.classList.contains('is-active'));
				applyFilter();
			})
		);
		if (allPill)
			allPill.addEventListener('click', () => {
				groupPills.forEach((p) => setPressed(p, false));
				applyFilter();
			});
	}
</script>
